# Frontend (Cloudflare Pages ou .env.local)
# A chave anon é pública por design; a proteção real é RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173
# Opcional: endpoint que recebe apenas nome de evento e rota, sem PII.
VITE_ANALYTICS_ENDPOINT=

# Edge Functions — configurar via `supabase secrets set` / painel.
# NUNCA expor estas variáveis no frontend nem commitar valores.
APP_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com
ASAAS_CHECKOUT_BASE_URL=https://sandbox.asaas.com
ASAAS_WEBHOOK_TOKEN=
BILLING_RECONCILE_TOKEN=

# Fornecidas automaticamente pelo runtime do Supabase:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
